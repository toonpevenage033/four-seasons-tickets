NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Local-only PostgreSQL-compatible development store; use pg on Render.
DB_DRIVER=pglite
PGLITE_PATH=.local/development
# DATABASE_URL=postgresql://user:password@localhost:5432/koorts
DATABASE_SSL=false

# No real payments/emails in this local configuration.
PAYMENT_MODE=test
PAYMENT_PROVIDER=mock
LIVE_SALES_ENABLED=false
MAIL_PROVIDER=preview
# Real test checkout: PAYMENT_PROVIDER=mollie + test_ key + public HTTPS BASE_URL.
MOLLIE_API_KEY=
# MAIL_PROVIDER=resend requires a verified sender, not a Gmail sender.
RESEND_API_KEY=
EMAIL_FROM=

# Only used by user:create; never commit passwords or pass them on command line.
CREATE_USERNAME=
CREATE_PASSWORD=
CREATE_ROLE=admin
