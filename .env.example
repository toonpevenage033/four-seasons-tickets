# Kopieer dit bestand naar ".env" en vul je eigen waarden in. Commit ".env" nooit naar git.

# Belangrijk: zorg dat je server in de juiste tijdzone draait voor de prijsfases
TZ=Europe/Amsterdam

# Poort waarop de server draait
PORT=3000

# Publieke URL van je site zodra die live staat
BASE_URL=http://localhost:3000

# Resend API key, aan te maken op https://resend.com
RESEND_API_KEY=re_your_resend_key_here
# E-mailadres waar tickets vandaan verstuurd worden (moet geverifieerd domein zijn bij Resend)
EMAIL_FROM="Four Seasons Feest <tickets@jouwdomein.nl>"

# Bankgegevens die getoond worden aan kopers om handmatig over te maken
PAYMENT_IBAN=NL00BANK0123456789
PAYMENT_ACCOUNT_HOLDER="Jouw naam of vereniging"

# Geheime code voor de beheerpagina (/admin) waar JIJ betalingen bevestigt.
# Houd dit apart van STAFF_TOKEN: alleen organisatoren mogen tickets kunnen aanmaken.
ADMIN_TOKEN=verander-dit-in-een-eigen-admin-code

# Geheime code die de deur-scanners moeten invoeren om tickets te mogen scannen
STAFF_TOKEN=verander-dit-in-een-eigen-geheime-code
