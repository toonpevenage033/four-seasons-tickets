{
  "name": "koorts-events",
  "version": "2.0.0",
  "private": true,
  "description": "KOORTS-EVENTS website en ticketbackend",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env server/cli.js seed",
    "user:create": "node --env-file-if-exists=.env server/cli.js user",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:postgres": "node tests/postgres-runner.js",
    "check": "node --check server/index.js && node --check server/app.js && node --check server/service.js && node --check js/tickets.js && node --check js/admin.js"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  }
}
